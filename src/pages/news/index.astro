---
import Base from "../../layouts/Base.astro";
import updates from "../../data/updates.json";
import site from "../../data/site.json";
import fs from "node:fs";
import path from "node:path";
const publicDir = path.resolve("./public");
function hasImage(u) {
  const imgs = u.images || [];
  if (imgs.length === 0) return false;
  return imgs.some((p) => {
    if (!p) return false;
    if (/^https?:\/\//i.test(p)) return true;
    const rel = p.startsWith("/") ? p.slice(1) : p;
    return fs.existsSync(path.join(publicDir, rel));
  });
}
const visibleUpdates = updates.filter(hasImage);
const linkMembers = (site.group.members || []).filter((m) => m.profile);
const escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const linkify = (t) => {
  if (!t) return t;
  const cands = [];
  for (const m of linkMembers) {
    cands.push({ name: m.name, href: m.profile });
    const first = m.name.split(" ")[0];
    if (first && first !== m.name) cands.push({ name: first, href: m.profile });
  }
  cands.sort((a, b) => b.name.length - a.name.length);
  let s = t;
  const placeholders = [];
  cands.forEach((c, i) => {
    const ph = "\x00LINK" + i + "\x00";
    const re = new RegExp("\\b" + escRe(c.name) + "\\b", "g");
    let hit = false;
    s = s.replace(re, () => { hit = true; return ph; });
    if (hit) placeholders.push({ ph, html: `<a class="ni-namelink" href="${c.href}">${c.name}</a>` });
  });
  for (const p of placeholders) s = s.split(p.ph).join(p.html);
  return s;
};
---
<Base title="News" description="Recent news and activities from Junaid Farooq and the CyReN Lab.">
  <div class="container">
    <section class="section">
      <span class="eyebrow">News</span>
      <h1 class="h-page">News &amp; activities</h1>
      <p class="lead">Recent activities, talks, awards, and updates from the lab.</p>

      <div class="news-feed">
        {visibleUpdates.map((u) => (
          <article class="news-item">
            <div class="ni-meta">
              <span class="ni-date">{u.date}</span>
            </div>
            <div class="ni-body">
              <p class="ni-text" set:html={linkify(u.message)}></p>
              {u.link && <a class="ni-link" href={u.link} target="_blank" rel="noopener">View details →</a>}
              {u.images && u.images.length > 0 && (
                <div class="ni-photos">
                  {u.images.map((img, i) => (
                    <img class="ni-photo" src={img} data-gallery={JSON.stringify(u.images)} data-index={i} alt="" loading="lazy" onerror="this.style.display='none'" />
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .news-feed { margin-top: 1.8rem; }
  .news-item { display: grid; grid-template-columns: 110px 1fr; gap: 1.4rem; padding: 1.8rem 0; border-top: 1px solid var(--border); }
  .ni-date { font-family: var(--ff-mono); font-size: 13px; color: var(--blue-link); padding-top: .2rem; display: inline-block; }
  .ni-text { font-size: 1.05rem; color: var(--text); margin: 0 0 .6rem; }
  .ni-text :global(.ni-namelink) { color: var(--blue-link); font-weight: 600; }
  .ni-link { font-family: var(--ff-mono); font-size: 13px; }
  .ni-photos { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 1rem; }
  .ni-photo { width: 240px; height: 168px; object-fit: cover; object-position: top; border-radius: 10px; border: 1px solid var(--border); cursor: zoom-in; transition: transform .2s; }
  .ni-photo:hover { transform: translateY(-2px); }
  @media (max-width: 700px) {
    .news-item { grid-template-columns: 1fr; gap: .5rem; }
    .ni-photo { width: calc(50% - 5px); height: auto; aspect-ratio: 4/3; object-fit: contain; background: var(--surface-soft); }
  }
  @media (max-width: 480px) {
    /* First photo full-width and uncropped; extras fit two per row */
    .ni-photo { width: 100%; height: auto; aspect-ratio: 4/3; max-height: 320px; object-fit: contain; background: var(--surface-soft); }
    .ni-photos .ni-photo ~ .ni-photo { width: calc(50% - 5px); aspect-ratio: 1/1; max-height: 180px; }
  }
</style>

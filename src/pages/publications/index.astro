---
import Base from "../../layouts/Base.astro";
import pubs from "../../data/publications.json";
import { bibtex } from "../../data/bibtex.js";
import tagAliases from "../../data/tagAliases.json";
import { venueFamily, venueSlug, venueBreakdown } from "../../data/venues.js";

// Build a synonym-expanded search haystack for each publication so that
// display labels like "NextG Networks" on the home page match papers whose
// real tags read "O-RAN" or "5G". For each synonym group: if ANY term in the
// group appears in the paper's content, ALL terms in the group are appended.
// Stable per-paper anchor id. Must match the slug used by the command palette.
const slug = (s) =>
  (s || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 80);

const aliasGroups = (tagAliases.synonyms || []).map((g) => g.map((t) => t.toLowerCase()));
function searchHaystack(p) {
  const base = (p.title + " " + p.authors_str + " " + p.venue + " " + (p.tags || []).join(" ")).toLowerCase();
  const extra = new Set();
  for (const group of aliasGroups) {
    for (const term of group) {
      if (base.indexOf(term) !== -1) {
        for (const t of group) extra.add(t);
        break;
      }
    }
  }
  return extra.size ? base + " " + Array.from(extra).join(" ") : base;
}

const types = ["All", "Journal", "Conference", "Book", "Book Chapter", "Preprint", "Thesis"];
const total = pubs.length;
const years = Array.from(new Set(pubs.map((p) => p.year))).sort((a, b) => b - a);
const authorList = Array.from(new Set(pubs.flatMap((p) => p.authors || []))).sort((a, b) => a.localeCompare(b));
function authorsHtml(s){ return s.replace(/(M\. J\. Farooq|J\. Farooq)/g, "<strong>$1</strong>"); }

// Heatmap data: count publications per year, excluding theses
const pubsNoThesis = pubs.filter(p => p.type !== "Thesis");
const _yc = {};
pubsNoThesis.forEach(p => { _yc[p.year] = (_yc[p.year]||0) + 1; });
const _yKeys = Object.keys(_yc).map(Number).sort((a,b)=>a-b);
const _yMax = Math.max(1, ..._yKeys.map(y => _yc[y]));
const yearBars = _yKeys.map(y => ({ year: y, n: _yc[y], h: Math.max(10, Math.round((_yc[y] / _yMax) * 100)) }));

// Tag cloud data: top topics by paper count
const _tc = {};
pubsNoThesis.forEach(p => (p.tags || []).forEach(t => { _tc[t] = (_tc[t]||0) + 1; }));
const _topTags = Object.entries(_tc).sort((a,b) => b[1]-a[1]).slice(0, 22);
const _tMax = Math.max(1, ..._topTags.map(x => x[1]));
const _tMin = Math.min(..._topTags.map(x => x[1]), _tMax);
const topTags = _topTags.map(([t, n]) => ({
  t, n,
  size: 11 + Math.round(((n - _tMin) / Math.max(1, _tMax - _tMin)) * 9)
}));

// Browse by venue: ranked bars per publication type. Bar width is relative to the
// busiest venue within that column, so the two columns scale independently.
function venueColumn(type) {
  const rows = venueBreakdown(pubs, type);
  const max = Math.max(1, ...rows.map((r) => r.count));
  return {
    total: rows.reduce((s, r) => s + r.count, 0),
    rows: rows.map((r) => ({ ...r, pct: Math.max(6, Math.round((r.count / max) * 100)) })),
  };
}
// Book shelf: every Book entry that has a cover, newest first.
const bookShelf = pubs
  .filter((p) => p.type === "Book" && p.cover)
  .sort((a, b) => b.year - a.year)
  .map((p) => ({
    ref: p.ref, year: p.year, cover: p.cover, title: p.title,
    publisher: (p.venue || "").replace(/\s*\(to appear\)\s*$/i, "").split(",")[0],
    href: p.url || (p.links && p.links[0] && p.links[0].url) || ("#" + slug(p.title)),
    forthcoming: /to appear/i.test(p.venue || ""),
  }));

const venueCols = [
  { label: "Journals", ...venueColumn("Journal") },
  { label: "Conferences", ...venueColumn("Conference") },
];
---
<Base title="Publications" description="Books, journal articles, and conference papers by Junaid Farooq.">
  <div class="container">
    <section class="section">
      <div class="page-head-row">
        <div>
          <span class="eyebrow">Publications</span>
          <h1 class="h-page">Publications</h1>
        </div>
        <a class="net-cta" href="/network">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/>
            <path d="M7 7l4 9M17 7l-4 9M7 6h10" stroke-linecap="round"/>
          </svg>
          <span>Collaboration network</span>
        </a>
      </div>
      <p class="lead">Author names are listed as published; an asterisk denotes a student advisee. The full record is also on <a href="https://scholar.google.com/citations?user=NiJ6vccAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener">Google Scholar</a>.</p>

      {bookShelf.length > 0 && (
        <section class="shelf reveal" aria-label="Books">
          <h2 class="shelf-head">Books</h2>
          <ul class="shelf-row">
            {bookShelf.map((b) => (
              <li class="shelf-item">
                <a class="shelf-link" href={b.href} target={b.href.startsWith("#") ? undefined : "_blank"} rel={b.href.startsWith("#") ? undefined : "noopener"}>
                  <img class="shelf-cover" src={b.cover} alt={`Cover of ${b.title}`} loading="lazy" width="200" height="280" />
                  <span class="shelf-meta">
                    <span class="shelf-pub">{b.publisher}</span>
                    <span class="shelf-year">{b.forthcoming ? "to appear " + b.year : b.year}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="pubviz reveal">
        <div class="yh">
          <div class="yh-head"><span class="yh-label">Activity by year</span><span class="yh-hint">click a bar to filter</span></div>
          <div class="yh-bars">
            {yearBars.map((b) => (
              <button type="button" class="yh-bar" data-year={b.year} title={`${b.year}: ${b.n} publication${b.n===1?'':'s'}`}>
                <span class="yh-num">{b.n}</span>
                <span class="yh-track"><span class="yh-fill" style={`height:${b.h}%`}></span></span>
                <span class="yh-year">{"'" + String(b.year).slice(-2)}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="tc">
          <div class="tc-head"><span class="tc-label">Browse by topic</span></div>
          <div class="tc-cloud">
            {topTags.map((t) => (
              <button type="button" class="tc-tag" data-tag={t.t} style={`font-size:${t.size}px`} title={`${t.n} paper${t.n===1?'':'s'}`}>{t.t}</button>
            ))}
          </div>
        </div>
      </div>

      <details class="vb reveal">
        <summary class="vb-sum">
          <svg class="vb-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="vb-title">Browse by venue</span>
          <span class="vb-hint">click a bar to filter</span>
        </summary>
        <div class="vb-cols">
          {venueCols.map((col) => (
            <div class="vb-col">
              <div class="vb-colhead">{col.label} <span class="vb-coln">{col.total}</span></div>
              <ul class="vb-list">
                {col.rows.map((r) => (
                  <li>
                    <button type="button" class="vb-bar" data-venue={r.slug} title={`${r.count} paper${r.count===1?'':'s'} in ${r.name}`}>
                      <span class="vb-name">{r.name}</span>
                      <span class="vb-track"><span class="vb-fill" style={`width:${r.pct}%`}></span></span>
                      <span class="vb-n">{r.count}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <div class="toolbar reveal">
        <div class="search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3" stroke-linecap="round"/></svg>
          <input id="q" type="search" placeholder="Search title, author, venue, topic…" autocomplete="off" />
        </div>
        <div class="chips" id="chips">
          {types.map((t) => <button class={"chip" + (t==="All"?" on":"")} data-t={t}>{t}</button>)}
        </div>
      </div>
      <div class="filters reveal">
        <label class="fl"><span>Year</span>
          <select id="year"><option value="All">All years</option>{years.map((y) => <option value={y}>{y}</option>)}</select>
        </label>
        <label class="fl"><span>Author</span>
          <select id="author"><option value="All">All authors</option>{authorList.map((a) => <option value={a}>{a}</option>)}</select>
        </label>
        <label class="fl"><span>Sort</span>
          <select id="sort">
            <option value="year-desc">Newest first</option>
            <option value="year-asc">Oldest first</option>
            <option value="title">Title A–Z</option>
          </select>
        </label>
        <label class="fl fl-check"><input type="checkbox" id="pdfonly" /> <span>Free PDF only</span></label>
      </div>
      <div class="count mono" id="count" style="display:none"></div>

      <div id="plist-top"></div>
      <ol class="plist" id="plist">
        {pubs.map((p) => (
          <li class="pitem" id={slug(p.title)} data-type={p.type} data-year={p.year} data-authors={(p.authors || []).join("|")} data-s={searchHaystack(p)} data-haspdf={(p.links || []).some((l) => l.label === "PDF") ? "1" : "0"} data-title={p.title} data-venue={venueSlug(venueFamily(p.venue))}>
            <div class="pi-year">
              {p.ref && <span class="pi-ref">{p.ref}</span>}
              <span class="pi-yr">{p.year}</span>
            </div>
            <div class="pi-body">
              <div class="pi-top">
                <span class={"badge b-" + p.type.toLowerCase().replace(" ","")}>{p.type}</span>
                {p.tags.map((t) => <a class="tag" href={"?q=" + encodeURIComponent(t)}>{t}</a>)}
              </div>
              <span class="pi-title">{p.title}</span>
              <div class="pi-auth" set:html={authorsHtml(p.authors_str)}></div>
              <div class="pi-venue">{p.venue}</div>
              <div class="pi-links">
                {p.links && p.links.map((l) => <a class="pi-link" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
                <button class="pi-link pi-cite-toggle" type="button">BibTeX</button>
              </div>
              <div class="pi-cite-box" hidden>
                <button type="button" class="pi-copy" aria-label="Copy BibTeX">Copy</button>
                <pre class="pi-bib">{bibtex(p)}</pre>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <div class="nores mono" id="nores" hidden>No matching publications.</div>
    </section>
  </div>
</Base>

<style>
  /* Page header with prominent network CTA */
  .page-head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.4rem; flex-wrap: wrap; }
  .net-cta { display: inline-flex; align-items: center; gap: .55rem; padding: .6rem 1rem; border: 1px solid var(--maize); background: var(--maize-soft); color: var(--blue); border-radius: 8px; font-family: var(--ff-mono); font-size: 12.5px; letter-spacing: .03em; text-decoration: none; transition: transform .15s, background .15s, border-color .15s; }
  .net-cta:hover { background: var(--maize); border-color: var(--blue); transform: translateY(-1px); text-decoration: none; }
  .net-cta svg { color: var(--blue); }
  :root[data-theme="dark"] .net-cta { background: rgba(255,203,5,.18); color: var(--maize); border-color: var(--maize); }
  :root[data-theme="dark"] .net-cta svg { color: var(--maize); }
  /* Dark hover: solid maize field needs dark ink, not the maize text set above. */
  :root[data-theme="dark"] .net-cta:hover { background: var(--maize); color: #00274c; border-color: var(--maize); }
  :root[data-theme="dark"] .net-cta:hover svg { color: #00274c; }

  /* Publication visualizations */
  /* Book shelf. Covers are the most striking thing on this page, so they lead it. */
  .shelf { margin: 1.8rem 0 .4rem; }
  .shelf-head { font-family: var(--ff-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--blue-link); margin: 0 0 .9rem; font-weight: 500; }
  .shelf-row { list-style: none; margin: 0; padding: 0 0 .4rem; display: flex; gap: 1.1rem; overflow-x: auto; scroll-snap-type: x proximity; }
  .shelf-item { flex: 0 0 auto; scroll-snap-align: start; }
  .shelf-link { display: block; width: 132px; text-decoration: none; }
  .shelf-link:hover { text-decoration: none; }
  .shelf-cover { display: block; width: 132px; height: auto; border-radius: 4px; border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0,39,76,.14); transition: transform .2s, box-shadow .2s; background: var(--bg-soft); }
  .shelf-link:hover .shelf-cover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,39,76,.22); }
  .shelf-meta { display: flex; flex-direction: column; gap: .1rem; margin-top: .5rem; }
  .shelf-pub { font-size: 11.5px; line-height: 1.3; color: var(--text-soft); }
  .shelf-year { font-family: var(--ff-mono); font-size: 10.5px; color: var(--text-mute); }
  .shelf-link:hover .shelf-pub { color: var(--blue-link); }
  @media (prefers-reduced-motion: reduce) { .shelf-cover { transition: none; } .shelf-link:hover .shelf-cover { transform: none; } }
  @media (max-width: 560px) { .shelf-link, .shelf-cover { width: 108px; } }

  .pubviz { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.4rem; margin: 1.8rem 0 1.2rem; }
  .yh, .tc { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.1rem 1.1rem; }
  .yh-head, .tc-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .8rem; }
  .yh-label, .tc-label { font-family: var(--ff-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--blue-link); }
  .yh-hint { font-family: var(--ff-mono); font-size: 10.5px; color: var(--text-mute); }
  .yh-bars { display: flex; align-items: flex-end; gap: 4px; height: 96px; }
  .yh-bar { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 0; background: none; border: 0; cursor: pointer; height: 100%; min-width: 24px; }
  .yh-num { font-family: var(--ff-mono); font-size: 9.5px; color: var(--text-mute); opacity: 0; transition: opacity .15s; line-height: 1; }
  .yh-bar:hover .yh-num, .yh-bar.on .yh-num { opacity: 1; color: var(--blue-link); }
  .yh-track { flex: 1; width: 100%; display: flex; align-items: flex-end; background: var(--surface-soft); border-radius: 3px; overflow: hidden; }
  .yh-fill { display: block; width: 100%; background: linear-gradient(180deg, var(--blue-link), var(--blue)); border-radius: 3px 3px 0 0; transition: background .2s, transform .25s; transform-origin: bottom; }
  .yh-bar:hover .yh-fill { background: linear-gradient(180deg, var(--maize), var(--blue)); }
  .yh-bar.on .yh-fill { background: var(--maize); }
  .yh-year { font-family: var(--ff-mono); font-size: 10px; color: var(--text-mute); line-height: 1; }
  .yh-bar:hover .yh-year, .yh-bar.on .yh-year { color: var(--blue-link); }

  .tc-cloud { display: flex; flex-wrap: wrap; gap: .35rem .55rem; align-items: center; line-height: 1.5; }
  .tc-tag { font-family: var(--ff-mono); border: 0; background: none; padding: .15rem .3rem; color: var(--text-soft); cursor: pointer; border-radius: 4px; transition: color .15s, background .15s; line-height: 1.2; }
  .tc-tag:hover { color: var(--blue); background: var(--maize-soft); }
  .tc-tag.on { color: var(--blue); background: var(--maize); }
  :root[data-theme="dark"] .tc-tag:hover, :root[data-theme="dark"] .tc-tag.on { color: var(--blue); }
  @media (max-width: 720px) { .pubviz { grid-template-columns: 1fr; } .yh-bars { height: 80px; } }

  /* Browse by venue — collapsed by default so the page still opens on the list. */
  .vb { border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 1.2rem; background: var(--surface); }
  .vb-sum { display: flex; align-items: center; gap: .5rem; padding: .7rem .9rem; cursor: pointer; list-style: none; user-select: none; }
  .vb-sum::-webkit-details-marker { display: none; }
  .vb-caret { color: var(--text-mute); flex: 0 0 auto; transition: transform .18s; }
  .vb[open] .vb-caret { transform: rotate(90deg); }
  .vb-title { font-family: var(--ff-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--blue-link); }
  .vb-hint { font-family: var(--ff-mono); font-size: 10.5px; color: var(--text-mute); margin-left: auto; }
  .vb-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem 1.8rem; padding: 0 .9rem 1rem; }
  .vb-col { min-width: 0; }
  .vb-colhead { font-family: var(--ff-mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--text-mute); padding-bottom: .45rem; border-bottom: 1px solid var(--border); margin-bottom: .5rem; }
  .vb-coln { color: var(--blue-link); }
  .vb-list { list-style: none; padding: 0; margin: 0; }
  .vb-bar { display: grid; grid-template-columns: minmax(0, 1fr) 34% 22px; align-items: center; gap: .55rem; width: 100%;
    border: 0; background: none; padding: .2rem .25rem; border-radius: 5px; cursor: pointer; text-align: left; font-family: inherit; }
  .vb-bar:hover { background: var(--bg-soft); }
  .vb-name { font-size: 12px; color: var(--text-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vb-track { height: 7px; border-radius: 4px; background: var(--bg-soft); overflow: hidden; }
  .vb-fill { display: block; height: 100%; background: var(--blue); border-radius: 4px; }
  .vb-n { font-family: var(--ff-mono); font-size: 11px; color: var(--text-mute); text-align: right; }
  .vb-bar:hover .vb-name { color: var(--blue-link); }
  .vb-bar.on .vb-name { color: var(--blue); font-weight: 600; }
  .vb-bar.on .vb-fill { background: var(--maize); }
  .vb-bar.on .vb-n { color: var(--blue-link); }
  :root[data-theme="dark"] .vb-fill { background: var(--blue-link); }
  :root[data-theme="dark"] .vb-bar.on .vb-name { color: var(--maize); }
  @media (max-width: 720px) { .vb-cols { grid-template-columns: 1fr; } .vb-bar { grid-template-columns: minmax(0, 1fr) 28% 22px; } }
  @media (prefers-reduced-motion: reduce) { .vb-caret { transition: none; } }

  .toolbar { display: flex; gap: .8rem; flex-wrap: wrap; align-items: center; justify-content: space-between; margin: 1.8rem 0 .6rem; }
  .search { display: flex; align-items: center; gap: .5rem; flex: 1 1 260px; min-width: 220px; background: var(--surface); border: 1px solid var(--border-strong); border-radius: 8px; padding: .1rem .8rem; color: var(--text-mute); }
  .search:focus-within { border-color: var(--blue); color: var(--blue); }
  #q { flex: 1; border: 0; outline: 0; background: none; font-family: var(--ff-sans); font-size: 14px; color: var(--text); padding: .55rem 0; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip { font-family: var(--ff-mono); font-size: 12px; padding: .42rem .7rem; border-radius: 7px; background: var(--surface); border: 1px solid var(--border); color: var(--text-soft); cursor: pointer; }
  .chip:hover { border-color: var(--border-strong); }
  .chip.on { background: var(--blue); color: #fff; border-color: var(--blue); }
  .count { font-size: 12px; color: var(--text-mute); margin: .4rem 0 1.2rem; font-family: var(--ff-mono); }
  .filters { display: flex; flex-wrap: wrap; gap: .9rem; margin: .7rem 0 0; }
  .fl { display: flex; align-items: center; gap: .45rem; font-family: var(--ff-mono); font-size: 12px; color: var(--text-mute); }
  .fl select { font-family: var(--ff-sans); font-size: 13px; color: var(--text); background: var(--surface); border: 1px solid var(--border-strong); border-radius: 7px; padding: .4rem .6rem; cursor: pointer; max-width: 220px; }
  .fl select:focus { outline: 0; border-color: var(--blue); }

  .plist { list-style: none; padding: 0; margin: 0; }
  .pitem { display: grid; grid-template-columns: 62px 1fr; gap: 1rem; padding: 1.3rem 0; border-top: 1px solid var(--border); }
  /* Reference label (J12, C34 …) above the year. These are the same numbers used
     in the CV, stored per entry as `ref` in publications.json, so they stay fixed
     no matter how the list is sorted or filtered. */
  .pi-year { font-family: var(--ff-mono); padding-top: .15rem; display: flex; flex-direction: column; gap: .15rem; }
  .pi-ref { font-size: 12px; font-weight: 600; color: var(--blue); letter-spacing: .02em; }
  :root[data-theme="dark"] .pi-ref { color: var(--maize); }
  .pi-yr { font-size: 13px; color: var(--blue-link); }
  .pi-top { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; margin-bottom: .45rem; }
  .pi-title { font-weight: 500; font-size: 1.05rem; color: var(--text); line-height: 1.34; }
  .pi-auth { font-size: .9rem; color: var(--text-soft); margin-top: .3rem; }
  .pi-auth strong { color: var(--blue); }
  :root[data-theme="dark"] .pi-auth strong { color: var(--maize); }
  .pi-venue { font-size: .85rem; color: var(--text-mute); font-style: italic; margin-top: .1rem; }
  .pi-links { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-top: .65rem; }
  .pi-link { display:inline-flex;align-items:center;justify-content:center;height:26px;padding:0 .65rem;margin:0;font-family:var(--ff-mono);font-size:11px;line-height:1;letter-spacing:.03em;border:1px solid var(--border-strong);border-radius:5px;color:var(--blue-link);background:var(--surface);cursor:pointer;text-decoration:none;box-sizing:border-box;-webkit-appearance:none;appearance:none; }
  .pi-link:hover { background: var(--blue); color: #fff; border-color: var(--blue); text-decoration: none; }
  .pi-cite-toggle { font-family: var(--ff-mono); cursor: pointer; }
  .pi-cite-toggle.on { background: var(--blue); color: #fff; border-color: var(--blue); }
  .pi-cite-box { position: relative; margin-top: .6rem; }
  .pi-bib { background: var(--surface-soft); border: 1px solid var(--border); border-radius: 6px; padding: .8rem 1rem; font-family: var(--ff-mono); font-size: 11.5px; line-height: 1.55; white-space: pre; overflow-x: auto; color: var(--text); margin: 0; }
  .pi-copy { position: absolute; top: 8px; right: 8px; font-family: var(--ff-mono); font-size: 11px; padding: .25rem .55rem; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--surface); color: var(--blue-link); cursor: pointer; }
  .pi-copy:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
  .pi-copy.ok { background: var(--maize); color: var(--blue); border-color: var(--maize); }
  .badge { font-family: var(--ff-mono); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; padding: .2rem .5rem; border-radius: 5px; }
  .b-journal { background: #00274c; color: #fff; }
  .b-conference { background: #ffcb05; color: #00274c; }
  .b-book, .b-bookchapter { background: #1f5394; color: #fff; }
  .b-thesis { background: var(--surface-soft); color: var(--text-mute); border: 1px solid var(--border); }
  .b-preprint { background: var(--surface-soft); color: var(--blue-link); border: 1px solid var(--border-strong); }
  :root[data-theme="dark"] .b-journal { background: #2b6cb0; color: #fff; }
  :root[data-theme="dark"] .b-conference { background: #ffcb05; color: #00274c; }
  .fl-check { cursor: pointer; user-select: none; }
  .fl-check input { accent-color: var(--blue); margin-right: .1rem; }
  .pitem { scroll-margin-top: 90px; }
  .pi-flash { animation: pi-flash 2.2s ease-out; border-radius: 8px; }
  @keyframes pi-flash {
    0%, 40% { background: var(--maize-soft); box-shadow: inset 3px 0 0 var(--maize); }
    100% { background: transparent; box-shadow: inset 3px 0 0 transparent; }
  }
  :root[data-theme="dark"] .pi-flash { animation-name: pi-flash-dark; }
  @keyframes pi-flash-dark {
    0%, 40% { background: rgba(255,203,5,.14); box-shadow: inset 3px 0 0 var(--maize); }
    100% { background: transparent; box-shadow: inset 3px 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) { .pi-flash { animation: none; box-shadow: inset 3px 0 0 var(--maize); } }
  .nores { padding: 2.5rem 0; color: var(--text-mute); }
  @media (max-width: 560px) { .pitem { grid-template-columns: 1fr; gap: .3rem; } }
</style>

<script is:inline>
  (function(){
    var q = document.getElementById("q"), list = document.getElementById("plist");
    var items = [].slice.call(list.querySelectorAll(".pitem"));
    var count = document.getElementById("count"), nores = document.getElementById("nores");
    var yearSel = document.getElementById("year"), authorSel = document.getElementById("author");
    var sortSel = document.getElementById("sort"), pdfOnly = document.getElementById("pdfonly");
    var active = "All";
    var venue = "All";   // canonical venue-family slug from "Browse by venue"
    var originalOrder = items.slice();

    function resort(){
      if(!sortSel) return;
      var mode = sortSel.value, arr = originalOrder.slice();
      if(mode === "year-asc"){
        arr.sort(function(a,b){ return (+a.getAttribute("data-year")) - (+b.getAttribute("data-year")); });
      } else if(mode === "title"){
        arr.sort(function(a,b){
          return (a.getAttribute("data-title")||"").localeCompare(b.getAttribute("data-title")||"");
        });
      }
      arr.forEach(function(el){ list.appendChild(el); });
    }

    function apply(){
      var s = (q.value||"").trim().toLowerCase(), n = 0;
      var yr = yearSel.value, au = authorSel.value;
      var wantPdf = pdfOnly && pdfOnly.checked;
      items.forEach(function(el){
        var okT = active==="All" || el.getAttribute("data-type")===active;
        var okS = !s || el.getAttribute("data-s").indexOf(s) !== -1;
        var okY = yr==="All" || el.getAttribute("data-year")===yr;
        var okA = au==="All" || ("|"+el.getAttribute("data-authors")+"|").indexOf("|"+au+"|") !== -1;
        var okP = !wantPdf || el.getAttribute("data-haspdf")==="1";
        var okV = venue==="All" || el.getAttribute("data-venue")===venue;
        var show = okT && okS && okY && okA && okP && okV; el.style.display = show?"":"none"; if(show) n++;
      });
      var filtering = (s !== "" || active !== "All" || yr !== "All" || au !== "All" || wantPdf || venue !== "All");
      count.style.display = filtering ? "" : "none";
      if (filtering) count.textContent = n + (n===1?" result":" results");
      nores.hidden = n!==0;
    }
    if(sortSel) sortSel.addEventListener("change", function(){ resort(); apply(); });
    if(pdfOnly) pdfOnly.addEventListener("change", apply);
    q.addEventListener("input", apply);
    yearSel.addEventListener("change", apply);
    authorSel.addEventListener("change", apply);
    document.getElementById("chips").addEventListener("click", function(e){
      var b = e.target.closest(".chip"); if(!b) return;
      active = b.getAttribute("data-t");
      document.querySelectorAll("#chips .chip").forEach(function(c){ c.classList.toggle("on", c===b); });
      apply();
    });
    var params = new URLSearchParams(location.search);
    var ptype = params.get("type");
    if(ptype){
      var chip = document.querySelector('#chips .chip[data-t="' + ptype.replace(/"/g,"") + '"]');
      if(chip){ active = chip.getAttribute("data-t"); document.querySelectorAll("#chips .chip").forEach(function(c){ c.classList.toggle("on", c===chip); }); }
    }
    var pyear = params.get("year"); if(pyear){ var yo = yearSel.querySelector('option[value="'+pyear.replace(/"/g,"")+'"]'); if(yo) yearSel.value = yo.value; }
    var pq = params.get("q"); if(pq){ q.value = pq; }
    apply();

    // Deep link: if the URL carries a #paper-slug, clear filters that would hide
    // it, then scroll to it and flash a highlight so the target is obvious.
    function focusHash(){
      var id = (location.hash || "").slice(1);
      if(!id) return;
      var el = document.getElementById(id);
      if(!el || !el.classList.contains("pitem")) return;
      if(el.style.display === "none"){
        q.value = ""; yearSel.value = "All"; authorSel.value = "All";
        if(pdfOnly) pdfOnly.checked = false;
        active = "All";
        venue = "All";
        document.querySelectorAll(".vb-bar.on").forEach(function(o){ o.classList.remove("on"); });
        document.querySelectorAll("#chips .chip").forEach(function(c){ c.classList.toggle("on", c.getAttribute("data-t")==="All"); });
        apply();
      }
      try { el.scrollIntoView({ behavior: "smooth", block: "center" }); } catch(e){}
      el.classList.add("pi-flash");
      setTimeout(function(){ el.classList.remove("pi-flash"); }, 2200);
    }
    focusHash();
    window.addEventListener("hashchange", focusHash);

    function safeScroll(){
      try { var t = document.getElementById("plist-top"); if(t && t.scrollIntoView) t.scrollIntoView({ behavior: "smooth", block: "start" }); } catch(e){}
    }
    // Year heatmap: event delegation so dynamic content still works
    var heat = document.querySelector(".yh-bars");
    if (heat) heat.addEventListener("click", function(e){
      var b = e.target.closest(".yh-bar"); if(!b) return;
      var y = b.getAttribute("data-year");
      var same = b.classList.contains("on");
      heat.querySelectorAll(".yh-bar.on").forEach(function(o){ o.classList.remove("on"); });
      if(same){ yearSel.value = "All"; }
      else { yearSel.value = y; b.classList.add("on"); }
      apply();
      safeScroll();
    });
    yearSel.addEventListener("change", function(){
      document.querySelectorAll(".yh-bar.on").forEach(function(o){ o.classList.remove("on"); });
      if(yearSel.value !== "All"){
        var bar = document.querySelector('.yh-bar[data-year="' + yearSel.value + '"]');
        if(bar) bar.classList.add("on");
      }
    });
    // Tag cloud: event delegation
    var cloud = document.querySelector(".tc-cloud");
    if (cloud) cloud.addEventListener("click", function(e){
      var t = e.target.closest(".tc-tag"); if(!t) return;
      var same = t.classList.contains("on");
      cloud.querySelectorAll(".tc-tag.on").forEach(function(o){ o.classList.remove("on"); });
      if(same){ q.value = ""; }
      else { q.value = t.getAttribute("data-tag"); t.classList.add("on"); }
      apply();
      safeScroll();
    });

    // Browse by venue: clicking a bar filters to that venue family; clicking the
    // active bar again clears it. Type chips are left alone so "Journal + venue"
    // combinations keep working.
    var vb = document.querySelector(".vb-cols");
    if (vb) vb.addEventListener("click", function(e){
      var b = e.target.closest(".vb-bar"); if(!b) return;
      var same = b.classList.contains("on");
      vb.querySelectorAll(".vb-bar.on").forEach(function(o){ o.classList.remove("on"); });
      venue = same ? "All" : b.getAttribute("data-venue");
      if(!same) b.classList.add("on");
      apply();
      safeScroll();
    });

    document.addEventListener("click", function(e){
      var tog = e.target.closest(".pi-cite-toggle");
      if(tog){
        var links = tog.closest(".pi-links");
        var box = links && links.nextElementSibling;
        if(box && box.classList.contains("pi-cite-box")){
          var nowHidden = !box.hidden;
          box.hidden = nowHidden;
          tog.classList.toggle("on", !nowHidden);
        }
        return;
      }
      var b = e.target.closest(".pi-copy"); if(!b) return;
      var pre = b.parentElement && b.parentElement.querySelector(".pi-bib"); if(!pre) return;
      var t = pre.textContent;
      (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(function(){
        var orig = b.textContent; b.textContent = "Copied!"; b.classList.add("ok");
        setTimeout(function(){ b.textContent = orig; b.classList.remove("ok"); }, 1500);
      }).catch(function(){
        var r = document.createRange(); r.selectNodeContents(pre);
        var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
      });
    });
  })();
</script>

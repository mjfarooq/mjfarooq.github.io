---
import all from "../data/updates.json";
import site from "../data/site.json";
import fs from "node:fs";
import path from "node:path";
// Hide items whose images aren't uploaded yet. External URLs are trusted;
// site-root paths (starting with "/") are checked against public/ on disk.
const publicDir = path.resolve("./public");
function hasImage(u) {
  const imgs = u.images || [];
  if (imgs.length === 0) return false;
  return imgs.some((p) => {
    if (!p) return false;
    if (/^https?:\/\//i.test(p)) return true;
    const rel = p.startsWith("/") ? p.slice(1) : p;
    return fs.existsSync(path.join(publicDir, rel));
  });
}
const withImages = all.filter(hasImage);
const isPub = (u) => u.category === "publication";
// Activities run as a full-bleed auto-advancing stage; publications stay a card row.
const activities = withImages.filter((u) => !isPub(u)).slice(0, 8);
const sections = [
  { title: "Publications", items: withImages.filter(isPub).slice(0, 12) },
];
// First existing image per activity drives the stage backdrop.
const firstImg = (u) => (u.images || []).find(Boolean) || "";
// Trim the message into a headline + supporting line for the caption.
function split(msg) {
  const plain = (msg || "").replace(/<[^>]*>/g, "");
  const i = plain.search(/(?<=[a-z0-9)\"])\.\s/);
  if (i > 40 && i < 190) return { head: plain.slice(0, i + 1), sub: plain.slice(i + 2).trim() };
  return { head: plain, sub: "" };
}
const linkMembers = (site.group.members || []).filter((m) => m.profile);
const escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const linkify = (t) => {
  if (!t) return t;
  const cands = [];
  for (const m of linkMembers) {
    cands.push({ name: m.name, href: m.profile });
    const first = m.name.split(" ")[0];
    if (first && first !== m.name) cands.push({ name: first, href: m.profile });
  }
  cands.sort((a, b) => b.name.length - a.name.length);
  let s = t;
  const placeholders = [];
  cands.forEach((c, i) => {
    const ph = "\x00LINK" + i + "\x00";
    const re = new RegExp("\\b" + escRe(c.name) + "\\b", "g");
    let hit = false;
    s = s.replace(re, () => { hit = true; return ph; });
    if (hit) placeholders.push({ ph, html: `<a class="uc-namelink" href="${c.href}">${c.name}</a>` });
  });
  for (const p of placeholders) s = s.split(p.ph).join(p.html);
  return s;
};
---
<div class="uc-wrap" id="updates">
  <div class="uc-top">
    <span class="eyebrow">Recent updates</span>
    <h2 class="h-sec">News from the lab</h2>
  </div>
  {activities.length > 0 && (
    <section class="uc-stage-wrap" aria-roledescription="carousel" aria-label="Recent activities">
      <div class="uc-head">
        <h2 class="uc-title">Activities</h2>
        <div class="uc-stage-meta">
          <button class="uc-pp" id="uc-pp" type="button" aria-label="Pause">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          </button>
          <span class="uc-count" id="uc-count"></span>
        </div>
      </div>

      <div class="uc-stage" id="uc-stage">
        <div class="uc-progress"><div class="uc-progress-bar" id="uc-bar"></div></div>
        {activities.map((u, i) => {
          const c = split(u.message);
          return (
            <article class={"uc-slide" + (i === 0 ? " on" : "")} data-i={i}
                     data-date={u.date} data-message={linkify(u.message)}
                     data-images={JSON.stringify(u.images || [])} data-link={u.link || ""}
                     aria-hidden={i === 0 ? "false" : "true"}>
              <img class="uc-slide-img" src={firstImg(u)} alt="" loading={i === 0 ? "eager" : "lazy"}
                   onerror="this.style.visibility='hidden'" />
              <div class="uc-scrim"></div>
              <div class="uc-cap">
                <span class="uc-cap-date">{u.date}</span>
                <h3 class="uc-cap-head">{c.head}</h3>
                {c.sub && <p class="uc-cap-sub">{c.sub}</p>}
                <button type="button" class="uc-cap-more uc-expand">Read more →</button>
              </div>
            </article>
          );
        })}
        <button class="uc-arrow uc-prev" id="uc-prev" type="button" aria-label="Previous activity">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="uc-arrow uc-next" id="uc-next" type="button" aria-label="Next activity">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="uc-dots" id="uc-dots" role="tablist" aria-label="Choose activity"></div>
    </section>
  )}

  {sections.map((sec) => sec.items.length > 0 && (
    <div class="uc">
      <div class="uc-head">
        <h2 class="uc-title">{sec.title}</h2>
        <div class="uc-nav">
          <button class="uc-btn" data-dir="-1" aria-label="Previous">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="uc-btn" data-dir="1" aria-label="Next">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <div class="uc-row">
        {sec.items.map((u) => (
          <article class="uc-card" data-date={u.date} data-message={linkify(u.message)} data-images={JSON.stringify(u.images || [])} data-link={u.link || ""}>
            {u.images && u.images.length > 0 && (
              <div class={"uc-photos n" + Math.min(u.images.length, 3)}>
                {u.images.slice(0, 3).map((img, i) => (
                  <div class="uc-photo">
                    <img src={img} style={`object-position:${(u.imgPos && u.imgPos[i]) || 'center'}`} data-gallery={JSON.stringify(u.images)} data-index={i} alt="" loading="lazy" onerror="this.closest('.uc-photo').style.display='none'" />
                    {i === 2 && u.images.length > 3 && <span class="uc-more" data-gallery={JSON.stringify(u.images)} data-index={i}>+{u.images.length - 3}</span>}
                  </div>
                ))}
              </div>
            )}
            <div class="uc-body">
              <span class="uc-date">{u.date}</span>
              <p class="uc-msg" set:html={linkify(u.message)}></p>
              <button type="button" class="uc-link uc-expand">Read more →</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}
</div>

<div class="uc-modal" id="uc-modal" aria-hidden="true">
  <div class="uc-modal-overlay" data-close></div>
  <div class="uc-modal-panel">
    <button class="uc-modal-close" type="button" data-close aria-label="Close">×</button>
    <div class="uc-modal-content">
      <span class="uc-modal-date"></span>
      <div class="uc-modal-images"></div>
      <p class="uc-modal-msg"></p>
      <a class="uc-modal-link" target="_blank" rel="noopener" hidden>Visit source →</a>
    </div>
  </div>
</div>

<style>
  .uc-wrap { display: flex; flex-direction: column; gap: 1.4rem; }
  .uc-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .7rem; }
  .uc-title { font-family: var(--ff-serif); font-size: 1.15rem; font-weight: 600; color: var(--blue); margin: 0; }
  :root[data-theme="dark"] .uc-title { color: var(--text); }
  .uc-nav { display: flex; gap: .5rem; }
  .uc-btn { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--surface); color: var(--blue); cursor: pointer; display: grid; place-items: center; transition: all .18s; }
  :root[data-theme="dark"] .uc-btn { color: var(--text); }
  .uc-btn:hover { background: var(--blue); color: #fff; border-color: var(--blue); }

  /* native horizontal scroll, identical to the student-page "In the news" strip */
  .uc-row { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 2px; }
  .uc-row::-webkit-scrollbar { display: none; }
  .uc-card { flex: 0 0 264px; height: 380px; scroll-snap-align: start; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }

  .uc-photos { display: grid; gap: 2px; height: 170px; flex: 0 0 170px; }
  .uc-photos.n1 { grid-template-columns: 1fr; }
  .uc-photos.n2 { grid-template-columns: 1fr 1fr; }
  .uc-photos.n3 { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
  .uc-photos.n3 .uc-photo:first-child { grid-row: 1 / 3; }
  .uc-photo { position: relative; overflow: hidden; background-color: var(--blue); }
  .uc-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; cursor: zoom-in; }
  /* single-image cards show the whole figure inside the fixed box (scaled, not cropped) */
  .uc-photos.n1 .uc-photo { background: var(--surface-soft); }
  .uc-photos.n1 .uc-photo img { object-fit: contain; }
  .uc-more { position: absolute; inset: 0; background: rgba(0,39,76,.62); color: #fff; font-family: var(--ff-mono); font-size: 15px; display: flex; align-items: center; justify-content: center; cursor: zoom-in; }

  .uc-body { padding: .85rem 1rem 1rem; display: flex; flex-direction: column; flex: 1; }
  .uc-date { font-family: var(--ff-mono); font-size: 11px; letter-spacing: .04em; color: var(--blue-link); background: var(--surface-soft); border: 1px solid var(--border); padding: .15rem .5rem; border-radius: 5px; align-self: flex-start; margin-bottom: .55rem; }
  .uc-msg { font-size: 13.5px; color: var(--text); line-height: 1.5; margin: 0 0 .6rem; display: -webkit-box; -webkit-line-clamp: 5; line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .uc-msg :global(.uc-namelink) { color: var(--blue-link); font-weight: 600; }
  .uc-expand { background: none; border: 0; padding: 0; cursor: pointer; font-family: var(--ff-mono); font-size: 12px; color: var(--blue-link); margin-top: auto; text-align: left; }
  .uc-expand:hover { text-decoration: underline; }

  .uc-modal { display: none; position: fixed; inset: 0; z-index: 1000; align-items: center; justify-content: center; padding: 24px; }
  .uc-modal.open { display: flex; }
  .uc-modal-overlay { position: absolute; inset: 0; background: rgba(8,18,34,.7); cursor: zoom-out; }
  .uc-modal-panel { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; max-width: 720px; width: 100%; max-height: 88vh; overflow-y: auto; padding: 2rem; box-shadow: 0 24px 70px rgba(0,0,0,.45); }
  .uc-modal-close { position: absolute; top: 12px; right: 12px; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--surface); color: var(--text); font-size: 22px; line-height: 1; cursor: pointer; display: grid; place-items: center; padding: 0; }
  .uc-modal-close:hover { background: var(--bg-soft); }
  .uc-modal-date { font-family: var(--ff-mono); font-size: 12px; letter-spacing: .04em; color: var(--blue-link); background: var(--surface-soft); border: 1px solid var(--border); padding: .2rem .55rem; border-radius: 5px; display: inline-block; }
  .uc-modal-images { display: flex; flex-direction: column; gap: 12px; margin: 1.1rem 0 1rem; }
  .uc-modal-images img { width: 100%; height: auto; max-height: 520px; object-fit: contain; border-radius: 8px; background: var(--surface-soft); cursor: zoom-in; }
  .uc-modal-msg { font-size: 1.02rem; line-height: 1.65; color: var(--text); margin: 0 0 1rem; }
  .uc-modal-msg :global(.uc-namelink) { color: var(--blue-link); font-weight: 600; }
  .uc-modal-link { font-family: var(--ff-mono); font-size: 13px; color: var(--blue-link); }
  .uc-link { font-family: var(--ff-mono); font-size: 12px; margin-top: auto; }

  /* ---- cinematic activities stage ---- */
  .uc-stage-wrap { display: flex; flex-direction: column; }
  .uc-stage-meta { display: flex; align-items: center; gap: .6rem; }
  .uc-pp { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--surface); color: var(--text-soft); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .uc-pp:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
  .uc-count { font-family: var(--ff-mono); font-size: 11px; color: var(--text-mute); min-width: 34px; text-align: right; }

  .uc-stage { position: relative; width: 100%; aspect-ratio: 16 / 9; max-height: 520px; border-radius: var(--radius); overflow: hidden; background: var(--blue); }
  .uc-progress { position: absolute; inset: 0 0 auto 0; height: 2px; background: rgba(255,255,255,.16); z-index: 4; }
  .uc-progress-bar { height: 100%; width: 0; background: var(--maize); }

  .uc-slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .9s ease, visibility .9s; }
  .uc-slide.on { opacity: 1; visibility: visible; }
  .uc-slide-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; transform: scale(1); }
  .uc-slide.on .uc-slide-img { animation: uc-drift 8s linear forwards; }
  @keyframes uc-drift { from { transform: scale(1); } to { transform: scale(1.07); } }
  .uc-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,18,38,.93) 0%, rgba(0,18,38,.58) 38%, rgba(0,18,38,.06) 72%); }

  .uc-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(1rem,2.4vw,1.7rem) clamp(1.1rem,2.6vw,1.9rem); max-width: 80%; }
  .uc-cap-date { display: inline-block; font-family: var(--ff-mono); font-size: 11px; letter-spacing: .07em; color: var(--maize); border: 1px solid rgba(255,203,5,.5); border-radius: 4px; padding: .18rem .5rem; margin-bottom: .6rem; }
  .uc-cap-head { font-family: var(--ff-serif); font-weight: 600; font-size: clamp(1.05rem,2.1vw,1.5rem); line-height: 1.26; color: #fff; margin: 0 0 .35rem; text-wrap: balance; }
  .uc-cap-sub { font-size: .9rem; line-height: 1.5; color: rgba(255,255,255,.74); margin: 0 0 .7rem; }
  .uc-cap-more, .uc-cap-more.uc-expand { background: none; border: 0; padding: 0; margin: 0; cursor: pointer; font-family: var(--ff-mono); font-size: 12px; color: var(--maize); text-align: left; }
  .uc-cap-more:hover { text-decoration: underline; }

  .uc-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255,255,255,.3); background: rgba(0,18,38,.42); color: #fff; display: grid; place-items: center; cursor: pointer; padding: 0; z-index: 3; opacity: 0; transition: opacity .2s, background .2s; }
  .uc-stage:hover .uc-arrow, .uc-arrow:focus-visible { opacity: 1; }
  .uc-arrow:hover { background: rgba(0,18,38,.72); }
  .uc-prev { left: 12px; } .uc-next { right: 12px; }

  .uc-dots { display: flex; gap: 5px; margin-top: .6rem; }
  .uc-dot { flex: 1; height: 3px; min-width: 0; padding: 0; border: 0; border-radius: 2px; background: var(--border-strong); cursor: pointer; transition: background .2s; }
  .uc-dot[aria-selected="true"] { background: var(--blue-link); }

  @media (max-width: 640px) {
    .uc-stage { aspect-ratio: 4 / 3; }
    .uc-cap { max-width: 100%; }
    .uc-arrow { opacity: 1; width: 32px; height: 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .uc-slide { transition: none; }
    .uc-slide.on .uc-slide-img { animation: none; }
  }


  /* Mobile: widen carousel cards, let photos scale by aspect ratio (no crop). */
  @media (max-width: 640px) {
    .uc-card { flex: 0 0 82vw; height: auto; min-height: 320px; }
    .uc-photos { height: auto; flex: 0 0 auto; aspect-ratio: 4 / 3; }
    /* Full frame, no cropping on mobile - the image is the point of the post. */
    .uc-photos .uc-photo { background: var(--surface-soft); }
    .uc-photos .uc-photo img { object-fit: contain; }
    /* Multi-image cards: show only the first on mobile to avoid tiny stamps. */
    .uc-photos.n2, .uc-photos.n3 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
    .uc-photos.n2 .uc-photo:nth-child(n+2),
    .uc-photos.n3 .uc-photo:nth-child(n+2) { display: none; }
    .uc-msg { -webkit-line-clamp: unset; line-clamp: unset; }
    .uc-modal-panel { padding: 1.2rem; max-height: 92vh; }
    .uc-modal-close { top: 8px; right: 8px; width: 32px; height: 32px; font-size: 20px; }
    .uc-nav { display: none; }
  }
</style>

<script is:inline>

    (function(){
      var stage = document.getElementById("uc-stage");
      if(!stage) return;
      var slides = [].slice.call(stage.querySelectorAll(".uc-slide"));
      if(!slides.length) return;
      var bar = document.getElementById("uc-bar"),
          dots = document.getElementById("uc-dots"),
          cnt = document.getElementById("uc-count"),
          pp = document.getElementById("uc-pp");
      var i = 0, playing = true, hovered = false, t0 = 0, DUR = 6200;
      var reduce = typeof matchMedia === "function" && matchMedia("(prefers-reduced-motion: reduce)").matches;

      var dl = slides.map(function(_, k){
        var b = document.createElement("button");
        b.className = "uc-dot"; b.type = "button"; b.setAttribute("role","tab");
        b.setAttribute("aria-label", "Activity " + (k+1));
        b.setAttribute("aria-selected", k === 0 ? "true" : "false");
        b.addEventListener("click", function(){ go(k); });
        dots.appendChild(b); return b;
      });

      function paint(){
        slides.forEach(function(s, k){
          s.classList.toggle("on", k === i);
          s.setAttribute("aria-hidden", k === i ? "false" : "true");
        });
        dl.forEach(function(b, k){ b.setAttribute("aria-selected", k === i ? "true" : "false"); });
        cnt.textContent = (i+1) + " / " + slides.length;
      }
      function go(n){ i = (n + slides.length) % slides.length; t0 = performance.now(); paint(); }
      function setPlay(v){
        playing = v;
        pp.innerHTML = v
          ? '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>'
          : '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>';
        pp.setAttribute("aria-label", v ? "Pause" : "Play");
        if(v) t0 = performance.now();
      }
      function tick(now){
        if(playing && !hovered){
          var p = Math.min(1, (now - t0) / DUR);
          bar.style.width = (p*100).toFixed(1) + "%";
          if(p >= 1) go(i+1);
        }
        requestAnimationFrame(tick);
      }

      pp.addEventListener("click", function(){ setPlay(!playing); });
      document.getElementById("uc-prev").addEventListener("click", function(){ go(i-1); });
      document.getElementById("uc-next").addEventListener("click", function(){ go(i+1); });
      stage.addEventListener("mouseenter", function(){ hovered = true; });
      stage.addEventListener("mouseleave", function(){ hovered = false; t0 = performance.now(); });
      stage.addEventListener("focusin", function(){ hovered = true; });
      stage.addEventListener("focusout", function(){ hovered = false; t0 = performance.now(); });
      // let the arrow keys drive it when the stage has focus
      stage.addEventListener("keydown", function(e){
        if(e.key === "ArrowLeft"){ e.preventDefault(); go(i-1); }
        else if(e.key === "ArrowRight"){ e.preventDefault(); go(i+1); }
      });

      paint();
      if(reduce){ setPlay(false); } else { t0 = performance.now(); requestAnimationFrame(tick); }
    })();
  (function(){
    document.querySelectorAll(".uc-wrap .uc").forEach(function(uc){
      var row = uc.querySelector(".uc-row");
      if(!row) return;
      function step(){ var c = row.querySelector(".uc-card"); return c ? c.offsetWidth + 16 : 280; }
      uc.querySelectorAll(".uc-btn").forEach(function(b){
        b.addEventListener("click", function(){ row.scrollBy({ left: parseInt(b.getAttribute("data-dir"),10) * step(), behavior: "smooth" }); });
      });
    });

    var modal = document.getElementById("uc-modal");
    if(modal){
      var msgEl = modal.querySelector(".uc-modal-msg");
      var dateEl = modal.querySelector(".uc-modal-date");
      var imgsEl = modal.querySelector(".uc-modal-images");
      var linkEl = modal.querySelector(".uc-modal-link");
      function openModal(card){
        dateEl.textContent = card.getAttribute("data-date") || "";
        msgEl.innerHTML = card.getAttribute("data-message") || "";
        imgsEl.innerHTML = "";
        try{
          var imgs = JSON.parse(card.getAttribute("data-images") || "[]");
          imgs.forEach(function(src){
            var img = document.createElement("img");
            img.src = src; img.alt = "";
            img.setAttribute("data-gallery", JSON.stringify(imgs));
            img.setAttribute("data-index", String(imgs.indexOf(src)));
            img.onerror = function(){ img.style.display = "none"; };
            imgsEl.appendChild(img);
          });
        }catch(e){}
        var link = card.getAttribute("data-link") || "";
        if(link){ linkEl.href = link; linkEl.hidden = false; } else { linkEl.hidden = true; }
        modal.classList.add("open");
        modal.setAttribute("aria-hidden","false");
        document.body.style.overflow = "hidden";
      }
      function closeModal(){
        modal.classList.remove("open");
        modal.setAttribute("aria-hidden","true");
        msgEl.innerHTML = ""; imgsEl.innerHTML = "";
        document.body.style.overflow = "";
      }
      document.addEventListener("click", function(e){
        var btn = e.target.closest(".uc-expand");
        if(btn){ openModal(btn.closest(".uc-card, .uc-slide")); return; }
        if(e.target.closest("#uc-modal [data-close]")){ closeModal(); }
      });
      document.addEventListener("keydown", function(e){ if(e.key === "Escape" && modal.classList.contains("open")) closeModal(); });
    }
  })();
</script>
